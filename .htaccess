# ==============================================================================
# INVENTO ERP - Production Apache / LiteSpeed Configuration (.htaccess)
# Fully Compatible with Hostinger Shared Hosting & LiteSpeed Web Server
# ==============================================================================

# 1. Set default directory index
DirectoryIndex index.php

# 2. Set default character set
AddDefaultCharset UTF-8

# 3. Disable multi-views if negotiation module exists
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# 4. Routing and Security Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Prevent infinite rewrite loop: if already index.php, stop processing immediately
    RewriteRule ^index\.php$ - [L]

    # Force HTTPS only on production domain (never on localhost or local IPs)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|::1)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct access to hidden files and directories (.env, .git, etc.)
    RewriteRule ^\..* - [F,L]

    # Block direct access to protected application folders
    RewriteRule ^(app|config|database|scripts|tests|storage/logs)(/.*)?$ - [F,L,NC]

    # Block direct access to sensitive config and script file types
    RewriteRule \.(env|sql|log|ini|sh|bat|bak|ya?ml)$ - [F,L,NC]

    # Serve existing static files directly (CSS, JS, Images, PDFs, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route directory requests to index.php
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ index.php [QSA,L]

    # Route all other web requests to the front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
