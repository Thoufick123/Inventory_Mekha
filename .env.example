# ========================================================
# INVENTO Multi-Concern Inventory System - Environment Template
# ========================================================

APP_NAME="INVENTO Multi-Concern ERP"
APP_ENV=local
APP_URL=http://localhost/inventory/inventory_mekha1
APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=true

# Database Settings (XAMPP / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invento_db
DB_USERNAME=root
DB_PASSWORD=

# Session Settings
SESSION_NAME=INVENTO_SESSID
SESSION_LIFETIME=86400

# ========================================================
# Cloudinary Image Storage Settings (Fill with your credentials)
# ========================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
